--- a/src/buffer.c
+++ b/src/buffer.c
@@ -244,10 +244,44 @@ static PMEMORY_BLOCK GetMemoryBlock(LPVOID pOrigin)
 }
 
 //-------------------------------------------------------------------------
-LPVOID AllocateBuffer(LPVOID pOrigin)
+LPVOID AllocateBuffer(LPVOID pOrigin, BOOL *pUsesAbsolutePatch)
 {
     PMEMORY_SLOT  pSlot;
     PMEMORY_BLOCK pBlock = GetMemoryBlock(pOrigin);
+
+    if (pUsesAbsolutePatch != NULL)
+        *pUsesAbsolutePatch = FALSE;
+
+#if defined(_M_X64) || defined(__x86_64__)
+    if (pBlock == NULL)
+    {
+        // Some large engines deliberately reserve or fragment every 64 KiB
+        // allocation slot near their main image.  The standard MinHook relay
+        // needs a nearby block for its 5-byte E9, but an absolute target patch
+        // does not.  Allocate a normal executable block and let hook.c select
+        // that 14-byte form instead of failing all otherwise-valid hooks.
+        pBlock = (PMEMORY_BLOCK)VirtualAlloc(
+            NULL, MEMORY_BLOCK_SIZE, MEM_COMMIT | MEM_RESERVE, PAGE_EXECUTE_READWRITE);
+        if (pBlock != NULL)
+        {
+            PMEMORY_SLOT pInitSlot = (PMEMORY_SLOT)pBlock + 1;
+            pBlock->pFree = NULL;
+            pBlock->usedCount = 0;
+            do
+            {
+                pInitSlot->pNext = pBlock->pFree;
+                pBlock->pFree = pInitSlot;
+                pInitSlot++;
+            } while ((ULONG_PTR)pInitSlot - (ULONG_PTR)pBlock <= MEMORY_BLOCK_SIZE - MEMORY_SLOT_SIZE);
+
+            pBlock->pNext = g_pMemoryBlocks;
+            g_pMemoryBlocks = pBlock;
+            if (pUsesAbsolutePatch != NULL)
+                *pUsesAbsolutePatch = TRUE;
+        }
+    }
+#endif
+
     if (pBlock == NULL)
         return NULL;
 
